# 复制为 .env 后填写。.env 已被 .gitignore 忽略，禁止提交真实凭据。

# Docker Compose 使用的数据库凭据（必填，请改成足够长的随机值）
POSTGRES_USER=student
POSTGRES_PASSWORD=
POSTGRES_DB=student
POSTGRES_PORT=5432
APP_PORT=3000

# 直接在本机运行应用或测试时使用（容器内由 compose 自动注入）
# 数据库连接串是本机开发用的示例，密码需与上面的 POSTGRES_PASSWORD 一致。
# 密码含特殊字符时请先做 URL 编码。
DATABASE_URL=postgres://student:CHANGE_ME@127.0.0.1:5432/student

# 可选：把连接固定到某个 schema。生产环境留空（使用 public），
# 测试脚手架会为每个测试文件注入独立的 schema。
DATABASE_SCHEMA=

# 每日备份（backup 服务）。容器时区为 UTC。
# 保留天数：超过该天数的备份会被删除。
BACKUP_RETENTION_DAYS=30
# cron 表达式：默认每天 03:00 UTC（北京时间 11:00）。
BACKUP_SCHEDULE="0 3 * * *"
# 异地/对象存储挂载点。生产环境必须改成真实的异地路径（NFS、对象存储挂载等）；
# 默认值只是同一块磁盘上的占位目录，与主备份同盘，不能抵御磁盘损坏。
# 该路径会被挂载为备份容器的 /offsite。
BACKUP_OFFSITE_HOST_DIR=./backups/offsite
