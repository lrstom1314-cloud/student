{
  "name": "student",
  "version": "0.1.0",
  "private": true,
  "description": "单机构教务系统",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test": "vitest run && npm run test:ops",
    "test:ops": "node --test tests/ops/*.test.mjs",
    "db:generate": "drizzle-kit generate && node scripts/strip-public-schema.mjs",
    "db:migrate": "node scripts/migrate.mjs",
    "account:create": "node scripts/create-account.mjs"
  },
  "dependencies": {
    "@node-rs/argon2": "^2.2.2",
    "drizzle-orm": "^0.45.4",
    "next": "^16.4.6",
    "postgres": "^4.1.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "drizzle-kit": "^0.31.11",
    "typescript": "^5.9.3",
    "vitest": "^5.1.0"
  }
}
